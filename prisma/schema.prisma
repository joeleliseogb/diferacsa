// Prisma Schema para Diferacsa ERP & TPV Multi-Sucursal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./diferacsa.db"
}

// ----------------------------------------------------
// 1. ESTRUCTURA MULTI-SUCURSAL Y MULTI-BODEGAS
// ----------------------------------------------------

model Branch {
  id          String      @id @default(cuid())
  code        String      @unique // e.g. "MATRIZ", "SUCURSAL-2"
  name        String      // "Casa Matriz - Ferretería González"
  address     String?
  phone       String?
  isMain      Boolean     @default(false)
  warehouses  Warehouse[]
  invoices    Invoice[]
  purchases   Purchase[]
  users       User[]
  transfersFrom StockTransfer[] @relation("TransferOrigin")
  transfersTo   StockTransfer[] @relation("TransferDest")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Warehouse {
  id          String         @id @default(cuid())
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code        String         // "BOD-1", "SALA-VENTAS"
  name        String         // "Bodega Principal / Sala de Ventas"
  isDefault   Boolean        @default(false)
  stocks      ProductStock[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([branchId, code])
}

// ----------------------------------------------------
// 2. CATÁLOGO MAESTRO DE ARTÍCULOS Y PRECIOS
// ----------------------------------------------------

model Category {
  id          Int       @id
  name        String    @unique
  products    Product[]
}

model Product {
  id          String         @id // e.g. "Prod10"
  sku         String         // e.g. "CEM5800"
  barcode     String?
  name        String
  description String?
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id])
  taxRate     Float          @default(0.12)
  isService   Boolean        @default(false)
  salesCount  Float          @default(0)
  stocks      ProductStock[]
  prices      ProductPrice[]
  purchaseItems PurchaseItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sku])
  @@index([name])
  @@index([salesCount])
}

model ProductStock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  minStock    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model ProductPrice {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierName    String   // "Normal", "Mayorista", "Especial"
  price       Float
  updatedAt   DateTime @updatedAt

  @@unique([productId, tierName])
}

// ----------------------------------------------------
// 3. CLIENTES Y PROVEEDORES
// ----------------------------------------------------

model Customer {
  id               String    @id
  code             String?
  name             String
  fiscalName       String?
  nit              String?
  email            String?
  phone            String?
  address          String?
  creditLimit      Float     @default(0)
  currentBalance   Float     @default(0)
  hasCredit        Boolean   @default(false)
  maxDiscount      Float     @default(0)
  priceTier        String    @default("Normal")
  invoices         Invoice[]
  creditMovements  CustomerCreditMovement[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([name])
  @@index([nit])
}

model Supplier {
  id             String   @id
  name           String
  contactPerson  String?
  nit            String?
  phone          String?
  email          String?
  address        String?
  currentBalance Float      @default(0)
  hasCredit      Boolean    @default(false)
  purchases      Purchase[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

// ----------------------------------------------------
// 4. VENTAS, FACTURAS Y TRASLADOS ENTRE SUCURSALES
// ----------------------------------------------------

model Invoice {
  id             String        @id
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  invoiceNumber  String
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  date           DateTime      @default(now())
  total          Float
  balance        Float         @default(0)
  isCredit       Boolean       @default(false)
  isCancelled    Boolean       @default(false)
  cashierName    String?
  items          InvoiceItem[]
  creditMovements CustomerCreditMovement[]
  deliveries     Delivery[]
  createdAt      DateTime      @default(now())

  @@index([branchId])
  @@index([date])
}

model InvoiceItem {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  quantity   Float
  price      Float
  total      Float
  discount   Float    @default(0)
  deliveryItems DeliveryItem[]
  creditNotes   CreditNote[]

  @@index([productId])
  @@index([invoiceId])
}

model Purchase {
  id             String         @id
  branchId       String         @default("branch-matriz")
  branch         Branch         @relation(fields: [branchId], references: [id])
  orderNumber    String         // e.g. "OC-001" o NoComprobante
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  date           DateTime       @default(now())
  total          Float
  isCredit       Boolean        @default(false)
  credit         Float?         @default(0)
  isCancelled    Boolean        @default(false)
  status         String         @default("Recibido") // "Pendiente", "Recibido", "Pagado", "Cancelado"
  notes          String?
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([date])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Float
  unitCost    Float
  total       Float
  isDelivered Boolean  @default(true)

  @@index([productId])
  @@index([purchaseId])
}

model StockTransfer {
  id             String         @id @default(cuid())
  fromBranchId   String
  fromBranch     Branch         @relation("TransferOrigin", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch         @relation("TransferDest", fields: [toBranchId], references: [id])
  status         String         @default("EN_TRANSITO") // "SOLICITADO", "EN_TRANSITO", "RECIBIDO", "CANCELADO"
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ----------------------------------------------------
// 5. USUARIOS, ROLES Y ACCESOS POR SUCURSAL
// ----------------------------------------------------

model User {
  id        String   @id
  username  String   @unique
  name      String
  email     String   @unique
  role      String   // "Admin", "Gerente General", "Gerente de Ventas", "Vendedor", "Contable", "Digitador de Compras", "Bodeguero"
  branchId  String   @default("branch-matriz")
  branch    Branch   @relation(fields: [branchId], references: [id])
  pin       String   @default("1234")
  password  String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

// ----------------------------------------------------
// 6. UNIDADES DE MEDIDA Y CONVERSIONES
// ----------------------------------------------------

model UnitOfMeasure {
  id          Int              @id
  name        String           @unique
  conversions UnitConversion[]
}

model UnitConversion {
  id              Int           @id
  name            String
  factor          Float
  unitOfMeasureId Int
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onDelete: Cascade)

  @@index([unitOfMeasureId])
}

// ----------------------------------------------------
// 7. ABONOS Y MOVIMIENTOS DE CRÉDITO DE CLIENTES
// ----------------------------------------------------

model CustomerCreditMovement {
  id          String    @id
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  date        DateTime  @default(now())
  reason      String?
  debit       Float     @default(0)
  credit      Float     @default(0)
  balance     Float     @default(0)
  userName    String?
  createdAt   DateTime  @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([date])
}

// ----------------------------------------------------
// 8. ENVÍOS, DESPACHOS Y ENTREGAS DE FACTURAS
// ----------------------------------------------------

model Delivery {
  id          String         @id
  invoiceId   String
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date        DateTime       @default(now())
  status      String         @default("ENTREGADO") // "PENDIENTE", "EN_RUTA", "ENTREGADO", "CANCELADO"
  notes       String?
  items       DeliveryItem[]
  createdAt   DateTime       @default(now())

  @@index([invoiceId])
  @@index([date])
}

model DeliveryItem {
  id            String      @id
  deliveryId    String
  delivery      Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  quantity      Float

  @@index([deliveryId])
  @@index([invoiceItemId])
}

// ----------------------------------------------------
// 9. NOTAS DE CRÉDITO Y DEVOLUCIONES
// ----------------------------------------------------

model CreditNote {
  id               String      @id
  invoiceItemId    String
  invoiceItem      InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  creditNoteNumber String?
  quantityReturned Float
  date             DateTime    @default(now())
  createdAt        DateTime    @default(now())

  @@index([invoiceItemId])
  @@index([date])
}
